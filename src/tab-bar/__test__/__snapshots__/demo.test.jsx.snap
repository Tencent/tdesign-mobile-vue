          <div
            class="t-tab-bar-item t-tab-bar-item--round-glass"
            data-v-dde4e901=""
          >
            <div
              aria-expanded="false"
              aria-selected="false"
              class="t-tab-bar-item__content t-tab-bar-item__content--tag"
              role="tab"
            >
              <div
                class="t-tab-bar-item__icon"
                style="height: 20px;"
              >
                
                <svg
                  class="t-icon t-icon-chat"
                  data-v-dde4e901=""
                  style="font-size: 20px;"
                >
                  <use
                    href="#t-icon-chat"
                  />
                </svg>
                
              </div>
              <div
                class="t-tab-bar-item__text t-tab-bar-item__text--small"
              >
                <!---->
                <!---->
              </div>
            </div>
            <!---->
          </div>
          <div
            class="t-tab-bar-item t-tab-bar-item--round-glass"
            data-v-dde4e901=""
          >
            <div
              aria-expanded="false"
              aria-selected="false"
              class="t-tab-bar-item__content t-tab-bar-item__content--tag"
              role="tab"
            >
              <div
                class="t-tab-bar-item__icon"
                style="height: 20px;"
              >
                
                <svg
                  class="t-icon t-icon-user"
                  data-v-dde4e901=""
                  style="font-size: 20px;"
                >
                  <use
                    href="#t-icon-user"
                  />
                </svg>
                
              </div>
              <div
                class="t-tab-bar-item__text t-tab-bar-item__text--small"
              >
                <!---->
